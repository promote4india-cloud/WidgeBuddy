# ==============================================================================
# WidgeBuddy — Environment Configuration
# ==============================================================================
# Copy this file to .env.local (or .env) and fill in your values.
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env or .env.local to version control.
# 2. Never store provider OAuth refresh tokens or secret keys in client environment
#    variables or client database tables.
# 3. Third-party provider API keys (OpenWeather, Todoist, RSS feeds) are configured
#    per-user in the `connections` table in Supabase — NOT in this file.
# 4. OAuth token exchanges and secret token storage are handled server-side
#    via Supabase Edge Functions / Vault when OAuth is implemented.
# ==============================================================================

# Supabase Project URL
# Found in Supabase Dashboard > Project Settings > API > Project URL
# Example: https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Public API Key
# Found in Supabase Dashboard > Project Settings > API > Project API Keys (anon / public)
# This key is safe to be embedded in the mobile client because all tables are
# protected by Row Level Security (RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
