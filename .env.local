# Environment Variables
# Copy this file to .env.local and fill in your values.

# Supabase project URL (found in Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (found in Project Settings > API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: Connector API keys (OpenWeather, etc.) are stored in the Supabase
# `connectors` table per user — never in this file. See docs/decisions.md ADR-007.
